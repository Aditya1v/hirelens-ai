# ---------------------------------------------------------------------------
# HireLens backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/hirelens

# JWT auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=hirelens_token

# Gemini API key (free, no credit card, no expiry) - used for structured
# resume extraction, ATS feedback, recommendations, and bullet improvement.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# "gemini-flash-latest" always points at Google's current default Flash
# model, so it won't break on the next model deprecation. Pin to a specific
# model (e.g. gemini-2.5-flash-lite) instead if you want fully reproducible
# behavior across Google's model updates.
GEMINI_MODEL=gemini-flash-latest

# Upload limits
MAX_UPLOAD_MB=10

